[Unit]
Description=Northstar Sentry localization stack (with rviz)
# Wait for the GUI to load before starting.
After=graphical.target docker.service
Wants=graphical.target docker.service

[Service]
# Must run as the desktop user (draws on their X display, and needs docker-group
# membership: `sudo usermod -aG docker northstar_agx`).
User=northstar_agx
Group=northstar_agx
Environment="DISPLAY=:0"
Environment="XAUTHORITY=/home/northstar_agx/.Xauthority"

WorkingDirectory=/home/northstar_agx/Docker/northstar_sentry_ros
ExecStart=/home/northstar_agx/Docker/northstar_sentry_ros/scripts/startup.sh
ExecStop=/usr/bin/docker rm -f ros-container
Type=simple
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
